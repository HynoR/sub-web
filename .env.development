# 开发环境短链接后端
VITE_APP_MYURLS_API = "https://suo.yt/short"

# 开发环境文本托管后端
VITE_APP_CONFIG_UPLOAD_API = "https://xxxx/upload"

# 页面配置
VITE_APP_USE_STORAGE = true 
VITE_APP_CACHE_TTL = 86400